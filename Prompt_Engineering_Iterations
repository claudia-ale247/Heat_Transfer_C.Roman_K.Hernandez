"""Ejercicio 5-34 - Diferencias finitas, 1D, estacionario, sin generación.
Todas las ecuaciones se escriben como balances de flujo de calor [W/m^2]
(se divide el balance en W entre el área A), de modo que todos los residuos
tienen las mismas unidades."""
import numpy as np
import matplotlib; matplotlib.use("Agg")
import matplotlib.pyplot as plt

km, kn = 36.0, 0.05            # W/(m K)
Lm, Ln = 0.030, 0.020          # m
dx = 0.005                     # m
q, Tinf, h = 150.0, 15.0, 5.0  # W/m^2, °C, W/(m^2 K)
N, ni = 11, 6                  # nodos 0..10, interfaz = nodo 6
x = np.arange(N) * dx

def ensamblar(h):
    """A T = b, con cada fila = balance de flujos en W/m^2 (signo: entra al nodo = +)."""
    A = np.zeros((N, N)); b = np.zeros(N)
    # Nodo 0: q'' + km (T1 - T0)/dx = 0
    A[0, 0], A[0, 1], b[0] = -km/dx, km/dx, -q
    # Interiores: k (T_{i-1} - T_i)/dx + k (T_{i+1} - T_i)/dx = 0   (k del material)
    for i in range(1, N-1):
        if i == ni: continue
        k = km if i < ni else kn
        A[i, i-1], A[i, i], A[i, i+1] = k/dx, -2*k/dx, k/dx
    # Interfaz: km (T5 - T6)/dx + kn (T7 - T6)/dx = 0
    A[ni, ni-1], A[ni, ni], A[ni, ni+1] = km/dx, -(km+kn)/dx, kn/dx
    # Nodo 10: kn (T9 - T10)/dx + h (Tinf - T10) = 0
    A[10, 9], A[10, 10], b[10] = kn/dx, -(kn/dx + h), -h*Tinf
    return A, b

def resolver(h):
    A, b = ensamblar(h)
    return A, b, np.linalg.solve(A, b)

A, b, T = resolver(h)

# --- Solución a mano (sustitución hacia atrás) ---------------------------
dT_m = q*dx/km                         # caída por nodo en el metal = 1/48 K
dT_n = (km/kn)*dT_m                    # de la interfaz: km dT_m = kn dT_n  -> 15 K
T10 = Tinf + (kn/dx)*dT_n/h            # nodo 10: (kn/dx) dT_n = h (T10 - Tinf)
T_mano = np.empty(N)
T_mano[10] = T10
for i in range(9, ni-1, -1): T_mano[i] = T_mano[i+1] + dT_n   # nodos 9..6
for i in range(ni-1, -1, -1): T_mano[i] = T_mano[i+1] + dT_m  # nodos 5..0
print("max |T_mano - T_numpy| =", np.abs(T_mano - T).max())

print("\nNodo  x[mm]   T[°C]")
for i in range(N): print(f"{i:4d} {x[i]*1000:6.1f}  {T[i]:.6f}")

# --- Flujos entre nodos y residuos [W/m^2] -------------------------------
k_tramo = [km]*ni + [kn]*(N-1-ni)      # tramos 0-1..5-6: metal; 6-7..9-10: no metal
flujos = [k_tramo[i]*(T[i]-T[i+1])/dx for i in range(N-1)]
print("\nFlujo por tramo [W/m^2]:", np.round(flujos, 9))
print("Flujo convectivo h(T10-Tinf):", h*(T[10]-Tinf))

res = A @ T - b                         # todos en W/m^2
grupos = {"Nodo 0 (flujo impuesto)": [0],
          "Interiores metal (1-5)": range(1, 6),
          "Interfaz (6)": [6],
          "Interiores no metal (7-9)": range(7, 10),
          "Nodo 10 (convección)": [10]}
print("\nResiduos máx. por tipo de ecuación [W/m^2]:")
for g, idx in grupos.items(): print(f"  {g:28s} {np.abs(res[list(idx)]).max():.2e}")

# Interfaz con temperaturas redondeadas (solo para ilustrar el redondeo)
print("\nInterfaz con T5=105.0208 (redondeado):", km*(105.0208-105.0)/dx, "vs", kn*(105.0-90.0)/dx)
print("Interfaz con T5 exacto:", km*(T[5]-T[6])/dx)

# --- Caídas de temperatura ----------------------------------------------
print("\nCaída metal:", T[0]-T[6], " no metal:", T[6]-T[10], " película convectiva:", T[10]-Tinf)

# --- Resistencias por unidad de área R'' [m^2 K/W] ----------------------
Rm_, Rn_, Rc_ = Lm/km, Ln/kn, 1/h
print("R'' metal, no metal, conv:", Rm_, Rn_, Rc_)
print("T10, T6, T0 por R'':", Tinf+q*Rc_, Tinf+q*(Rc_+Rn_), Tinf+q*(Rc_+Rn_+Rm_))

# --- h umbral ------------------------------------------------------------
inv_h = (93-Tinf)/q - Rn_ - Rm_
h_umb = 1/inv_h
print("\n1/h umbral =", inv_h, " h umbral =", h_umb, " (=1200/143 =", 1200/143, ")")
for hh in (8.39, h_umb, 8.5, 10.0):
    print(f"h = {hh:.6f} -> Tmax = {resolver(hh)[2][0]:.6f} °C")

# --- Gráfica -------------------------------------------------------------
fig, ax = plt.subplots(1, 2, figsize=(11, 4.5))
for a in ax:
    a.axvspan(0, 30, color="tab:blue", alpha=.08); a.axvspan(30, 50, color="tab:orange", alpha=.08)
    a.axvline(30, color="gray", ls=":"); a.grid(alpha=.3); a.set_xlabel("x [mm]")
ax[0].plot(x*1000, T, "o-"); ax[0].axhline(93, color="r", ls="--", label="Límite 93 °C")
ax[0].text(3, 48, "Metal SB-96", fontsize=9); ax[0].text(33, 98, "No metal", fontsize=9)
ax[0].set_ylabel("T [°C]"); ax[0].set_title("T(x), h = 5 W/m²·K"); ax[0].legend()
ax[1].plot(x[:ni+1]*1000, T[:ni+1], "o-"); ax[1].set_title("Zoom en el metal (pendiente pequeña, no nula)")
ax[1].set_ylabel("T [°C]")
plt.tight_layout(); plt.savefig("T_vs_x_5_34.png", dpi=150)
